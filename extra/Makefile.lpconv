#@file    Makefile.lpconv
#@brief   LPConv Makefile
#@author  Thorsten Koch

#-----------------------------------------------------------------------------
# detect host architecture
#-----------------------------------------------------------------------------

include make/make.detecthost


#-----------------------------------------------------------------------------
# default settings
#-----------------------------------------------------------------------------

VERBOSE		=	false
SHARED		=	false
OPT		=	opt
LTO		=	false
STATICLIBEXT	=	a
SHAREDLIBEXT	=	so
LIBEXT		=	$(STATICLIBEXT)
EXEEXTENSION	=

# is it allowed to link to external open source libraries?
OPENSOURCE	=	true

ZLIB     =  true
QUADMATH =  false
BOOST    =  false
GMP      =  auto
MPFR     =  auto
SYSTEM_FMT = false

ifeq ($(OSTYPE),darwin)
COMP		=	clang
else
COMP		=	gnu
endif
CXX		=	g++
CXX_c		=	-c # the trailing space is important
CXX_o		=	-o # the trailing space is important
LINKCXX		=	$(CXX)
LINKCXX_L	=	-L
LINKCXX_l	=	-l
LINKCXX_o	=	-o # the trailing space is important

# find soplex/config.h in build dir
CPPFLAGS	=	-I$(OBJDIR)/include -Isrc
CXXFLAGS	=
BINOFLAGS	=
LDFLAGS		=
DFLAGS		=	-MMD

FMT_LDFLAGS	= 	-lfmt
GMP_LDFLAGS	= 	-lgmp
GMP_CPPFLAGS	=
QUADMATH_LDFLAGS = 	-lquadmath

SRCDIR		=	extra
BINDIR		=	bin
LIBDIR		=	lib
NAME		=	lpconv

BINOBJ		=	lpconv.o

BASE		=	$(OSTYPE).$(ARCH).$(COMP).$(OPT)

#------------------------------------------------------------------------------
#--- NOTHING TO CHANGE FROM HERE ON -------------------------------------------
#------------------------------------------------------------------------------

GCCWARN		=	-pedantic -Wall -W -Wpointer-arith -Wcast-align -Wwrite-strings \
			-Wconversion -Wsign-compare -Wshadow \
			-Wredundant-decls -Wdisabled-optimization \
			-Wnon-virtual-dtor -Wreorder \
			-Woverloaded-virtual -Wsign-promo -Wsynth -Wundef \
			-Wcast-qual \
			-Wmissing-declarations \
			-Wzero-as-null-pointer-constant \
			-Wno-unused-parameter -Wno-strict-overflow -Wno-long-long \
			-Wno-sign-conversion -Wno-enum-enum-conversion
#			-Wold-style-cast
#			-Weffc++


#-----------------------------------------------------------------------------
include make/make.$(BASE)
-include make/local/make.$(HOSTNAME)
-include make/local/make.$(HOSTNAME).$(COMP)
-include make/local/make.$(HOSTNAME).$(COMP).$(OPT)
#-----------------------------------------------------------------------------

#-----------------------------------------------------------------------------
# SHARED Libaries
#-----------------------------------------------------------------------------

ifeq ($(SHARED),true)
ifeq ($(COMP),msvc)
LIBEXT		=	dll
else
LIBEXT		=	$(SHAREDLIBEXT)
LINKRPATH	=	-Wl,-rpath,
endif
endif

CPPFLAGS	+=	$(USRCPPFLAGS)
CXXFLAGS	+=	$(USRCXXFLAGS)
LDFLAGS		+=	$(USRLDFLAGS)

#-----------------------------------------------------------------------------
# Main Program
#-----------------------------------------------------------------------------

BINNAME		=	$(NAME).$(BASE)
LIBNAME		=	soplex.$(BASE)
BINFILE		=	$(BINDIR)/$(BINNAME)$(EXEEXTENSION)
LIBLINK		=	$(LIBDIR)/lib$(LIBNAME).$(LIBEXT)

OBJDIR		=	obj/O.$(BASE)
BINOBJDIR	=	$(OBJDIR)/bin
BINOBJFILES	=	$(addprefix $(BINOBJDIR)/,$(BINOBJ))

#-----------------------------------------------------------------------------
# External Libraries
#-----------------------------------------------------------------------------

# check if it is allowed to link to external open source libraries
ifeq ($(OPENSOURCE), false)
	override ZLIB	=	false
	override BOOST	=	false
	override GMP	=	false
	override MPFR	=	false
endif

# For system FMT
ifeq ($(SYSTEM_FMT),true)
	LDFLAGS += $(FMT_LDFLAGS)
else
	FMT_LDFLAGS =
endif

ifeq ($(GMP),auto)
GMP     =  $(BOOST)
endif

ifeq ($(MPFR),auto)
MPFR     =  $(BOOST)
endif

ifeq ($(GMP),true)
CPPFLAGS	+= $(GMP_CPPFLAGS)
LDFLAGS	+= $(GMP_LDFLAGS)
else
GMP_LDFLAGS	=
GMP_CPPFLAGS	=
endif

# For MPFR, needed for rational solving with precision boosting
ifeq ($(MPFR),true)
LDFLAGS += -lmpfr
else
# Flags for cpp mpf
endif

# For boost multiprecision, needed for rational solving
ifeq ($(BOOST),true)
	LDFLAGS += $(BOOST_LDFLAGS)
else
		BOOST_LDFLAGS =
endif

# For quadmath support
ifeq ($(QUADMATH),true)
	LDFLAGS += $(QUADMATH_LDFLAGS)
else
	QUADMATH_LDFLAGS =
endif


ifeq ($(ZLIB_LDFLAGS),)
ZLIB		=	false
endif
ifeq ($(ZLIB),true)
FLAGS	+= $(ZLIB_FLAGS)
LDFLAGS		+=	$(ZLIB_LDFLAGS)
else
ZLIB_LDFLAGS	=
ZLIB_FLAGS	=
endif


#-----------------------------------------------------------------------------
# Rules
#-----------------------------------------------------------------------------

ifeq ($(VERBOSE),false)
.SILENT:	$(BINFILE) $(BINOBJFILES)
MAKE		+= -s
endif

.PHONY: all
all:		$(BINFILE)

ifeq ($(SHARED),true)
$(BINFILE):	$(LIBLINK) $(BINOBJFILES) | $(BINDIR) $(BINOBJDIR)
		@echo "-> linking $@"
		$(LINKCXX) $(BINOBJFILES) \
		$(LDFLAGS) $(LINKCXX_L)$(LIBDIR) $(LINKRPATH)\$$ORIGIN/../$(LIBDIR) $(LINKCXX_l)$(LIBNAME) $(LINKCXX_o)$@
else
$(BINFILE):	$(LIBLINK) $(BINOBJFILES) | $(BINDIR) $(BINOBJDIR)
		@echo "-> linking $@"
		$(LINKCXX) $(BINOBJFILES) $(LIBLINK) \
		$(LDFLAGS) $(LINKCXX_o)$@
endif

.PHONY: clean
clean:
		@echo "remove binary $(BINFILE)"
		@-rm -f $(BINFILE)
		@echo "remove objective files"
		@-rm -f $(BINOBJFILES) $(BINOBJFILES:.o=.d)

$(BINOBJDIR):
		@-mkdir -p $(BINOBJDIR)

$(BINDIR):
		@-mkdir -p $(BINDIR)

# do not attempt to include .d files if there will definitely be any (empty DFLAGS), because it slows down the build on Windows considerably
ifneq ($(DFLAGS),)
-include $(BINOBJFILES:.o=.d)
else
ifeq ($(VERBOSE),true)
$(info No compilation dependencies. If changing header files, do a make clean before building.)
endif
endif

$(BINOBJDIR)/%.o:	$(SRCDIR)/%.cpp
		@-mkdir -p $(BINOBJDIR)
		@echo "-> compiling $@"
		$(CXX) $(FLAGS) $(CPPFLAGS) $(CXXFLAGS) $(BINOFLAGS) $(DFLAGS) $(CXX_c)$< $(CXX_o)$@
