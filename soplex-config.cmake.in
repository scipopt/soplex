# This CMake configuration exposes the following targets:
#
# SOPLEX::SOPLEX             alias to SOPLEX::libsoplex
# SOPLEX::libsoplex          SoPlex C++ library.
# SOPLEX::soplex-executable  The SoPlex executable.
#
# Moreover, it defines the following variables:
#
# SOPLEX_FOUND               Indicates whether SoPlex was found
# SOPLEX_VERSION             Version string

# Check if already found.
if(TARGET SOPLEX::SOPLEX)
   if(NOT SOPLEX_FIND_QUIETLY)
      message(STATUS "Already found suitable SoPlex version ${SOPLEX_VERSION}.")
   endif()
else()
  if(NOT SOPLEX_FIND_QUIETLY)
     message(STATUS "Checking SoPlex: ${CMAKE_CURRENT_LIST_FILE}")
  endif()
endif()

# Whether libsoplex is built with position-independent code.
set(SOPLEX_HAS_PIC @SOPLEX_HAS_PIC@)

# Whether SoPlex was built with ZLIB.
set(SOPLEX_HAS_ZLIB @SOPLEX_HAS_ZLIB@)

# Whether SoPlex was built with GMP.
set(SOPLEX_HAS_GMP @SOPLEX_HAS_GMP@)

# Whether SoPlex was built with Quadmath.
set(SOPLEX_HAS_QUADMATH @SOPLEX_HAS_QUADMATH@)

# Whether SoPlex was built with PaPILO.
set(SOPLEX_HAS_PAPILO @SOPLEX_HAS_PAPILO@)

# Whether SoPlex was built with MPFR.
set(SOPLEX_HAS_MPFR @SOPLEX_HAS_MPFR@)

# Whether SoPlex was built with Boost.
set(SOPLEX_HAS_BOOST @SOPLEX_HAS_BOOST@)
set(SOPLEX_HAS_CPPRAT @SOPLEX_HAS_CPPRAT@)
set(SOPLEX_HAS_CPPMPF @SOPLEX_HAS_CPPMPF@)

# Whether SoPlex used system FMT then we inform the consumer.
set(SOPLEX_HAS_SYSTEM_FMT @SOPLEX_HAS_SYSTEM_FMT@)

# Dependency search and inclusion of targets.
if(NOT TARGET SOPLEX::SOPLEX)
   # Indent messages for dependency search.
   list(APPEND CMAKE_MESSAGE_INDENT "  ")
   
   # For `find_dependency` function.
   include(CMakeFindDependencyMacro)
   
   list(APPEND CMAKE_MODULE_PATH @EXTRA_CMAKE_MODULE_PATH@)
   
   # If SoPlex was built with ZLIB then we also need it.
   @SOPLEX_CONFIG_ZLIB_DIR@
   if(SOPLEX_HAS_ZLIB)
      find_dependency(ZLIB)
   endif()
   
   # If SoPlex was built with GMP then we also need it.
   @SOPLEX_CONFIG_GMP_DIR@
   if(SOPLEX_HAS_GMP)
      find_dependency(GMP)
   
      # Support legacy FindGMP.cmake module when importing SoPlex.
      if(GMP_FOUND AND NOT TARGET GMP::GMP)
         if(TARGET GMP::gmp)
            message(WARNING "Found GMP version \"${GMP_VERSION}\" has no GMP::GMP target; interfacing GMP::gmp target instead.")
            add_library(GMP::GMP INTERFACE IMPORTED)
            target_link_libraries(GMP::GMP INTERFACE GMP::gmp)
         elseif(TARGET GMP)
            message(WARNING "Found GMP version \"${GMP_VERSION}\" has no GMP::GMP target; interfacing GMP target instead.")
            add_library(GMP::GMP INTERFACE IMPORTED)
            target_link_libraries(GMP::GMP INTERFACE GMP)
         elseif(TARGET gmp)
            message(WARNING "Found GMP version \"${GMP_VERSION}\" has no GMP::GMP target; interfacing gmp target instead.")
            add_library(GMP::GMP INTERFACE IMPORTED)
            target_link_libraries(GMP::GMP INTERFACE gmp)
         elseif(GMP_INCLUDE_DIRS AND GMP_LIBRARIES)
            message(WARNING "Found GMP version \"${GMP_VERSION}\" has no GMP::GMP target; using legacy variables GMP_INCLUDE_DIRS=\"${GMP_INCLUDE_DIRS}\" and GMP_LIBRARIES=\"${GMP_LIBRARIES}\" instead.")
            # GMP_LIBRARIES may be a list, so we need to create each library seperately and glue them via an INTERFACE library.
            list(LENGTH GMP_LIBRARIES num_gmp_lib)
            math(EXPR last_gmp_lib ${num_gmp_lib}-1)
            add_library(GMP_libgmp INTERFACE IMPORTED)
            foreach(id_gmp_lib RANGE ${last_gmp_lib})
               add_library(GMP::libgmp_${id_gmp_lib} UNKNOWN IMPORTED)
               list(GET GMP_LIBRARIES ${id_gmp_lib} the_gmp_lib)
               set_target_properties(GMP::libgmp_${id_gmp_lib} PROPERTIES
                  IMPORTED_LOCATION "${the_gmp_lib}"
                  INTERFACE_INCLUDE_DIRECTORIES "${GMP_INCLUDE_DIRS}")
               target_link_libraries(GMP_libgmp INTERFACE GMP::libgmp_${id_gmp_lib})
            endforeach()
            add_library(GMP::GMP INTERFACE IMPORTED)
            target_link_libraries(GMP::GMP INTERFACE GMP_libgmp)
         else()
            message(FATAL_ERROR "Found GMP version \"${GMP_VERSION}\" has no GMP::GMP target; unable to recover!")
         endif()
      endif()
   endif()
   
   # If SoPlex was built with Quadmath then we also need it.
   @SOPLEX_CONFIG_QUADMATH_DIR@
   if(SOPLEX_HAS_QUADMATH)
      find_dependency(Quadmath)
   
      # Support legacy FindQuadmath.cmake module when importing PaPILO.
      if(Quadmath_FOUND AND NOT TARGET Quadmath::Quadmath)
         if(TARGET Quadmath::quadmath)
            message(WARNING "Found Quadmath version has no Quadmath::Quadmath target; interfacing Quadmath::quadmath target instead.")
            add_library(Quadmath::Quadmath INTERFACE IMPORTED)
            target_link_libraries(Quadmath::Quadmath INTERFACE Quadmath::quadmath)
         elseif(QUADMATH_INCLUDE_DIRS AND QUADMATH_LIBRARIES)
            message(WARNING "Found Quadmath version has no Quadmath::Quadmath target; using legacy variables QUADMATH_INCLUDE_DIRS=\"${QUADMATH_INCLUDE_DIRS}\" and QUADMATH_LIBRARIES=\"${QUADMATH_LIBRARIES}\" instead.")
            add_library(Quadmath::Quadmath UNKNOWN IMPORTED)
            set_target_properties(Quadmath::Quadmath PROPERTIES
               IMPORTED_LOCATION "${QUADMATH_LIBRARIES}"
               INTERFACE_INCLUDE_DIRECTORIES "${QUADMATH_INCLUDE_DIRS}"
               )
         else()
            message(FATAL_ERROR "Found Quadmath version has no Quadmath::Quadmath target; unable to recover!")
         endif()
      endif()
   endif()
   
   # If SoPlex was built with PaPILO then we also need it.
   @SOPLEX_CONFIG_PAPILO_DIR@
   if(SOPLEX_HAS_PAPILO)
      find_dependency(PAPILO)
   
      # Support older PaPILO versions that do not export PAPILO::PAPILO.
      if(PAPILO_FOUND AND NOT TARGET PAPILO::PAPILO)
         if(TARGET papilo)
            message(WARNING "Found PaPILO has no PAPILO::PAPILO target when importing SoPlex; using alias to papilo instead; consider using a more recent PaPILO version.")
            add_library(PAPILO::PAPILO ALIAS papilo)
         else()
            set(SOPLEX_FOUND 0)
            set(SOPLEX_NOT_FOUND_MESSAGE "SoPlex could not be found because PAPILO::PAPILO target is missing.")
         endif()
      endif()
   endif()
   
   # If SoPlex was built with MPFR then we also need it.
   @SOPLEX_CONFIG_MPFR_DIR@
   if(SOPLEX_HAS_MPFR)
      find_dependency(MPFR)
   
      # Support legacy FindMPFR.cmake module when importing SoPlex.
      if(MPFR_FOUND AND NOT TARGET MPFR::MPFR)
         if(TARGET MPFR::mpfr)
            message(WARNING "Found MPFR version \"${MPFR_VERSION}\" has no MPFR::MPFR target; interfacing MPFR::mpfr instead.")
            add_library(MPFR::MPFR INTERFACE IMPORTED)
            target_link_libraries(MPFR::MPFR INTERFACE MPFR::mpfr)
         elseif(TARGET MPFR)
            message(WARNING "Found MPFR version \"${MPFR_VERSION}\" has no MPFR::MPFR target; interfacing MPFR instead.")
            add_library(MPFR::MPFR INTERFACE IMPORTED)
            target_link_libraries(MPFR::MPFR INTERFACE MPFR)
         elseif(TARGET mpfr)
            message(WARNING "Found MPFR version \"${MPFR_VERSION}\" has no MPFR::MPFR target; interfacing mpfr instead.")
            add_library(MPFR::MPFR INTERFACE IMPORTED)
            target_link_libraries(MPFR::MPFR INTERFACE mpfr)
         elseif(MPFR_INCLUDE_DIRS AND MPFR_LIBRARIES)
            message(WARNING "Found MPFR version \"${MPFR_VERSION}\" has no MPFR::MPFR target; using legacy variables MPFR_INCLUDE_DIRS=\"${MPFR_INCLUDE_DIRS}\" and MPFR_LIBRARIES=\"${MPFR_LIBRARIES}\" instead.")
            # MPFR_LIBRARIES may be a list, so we need to create each library seperately and glue them via an INTERFACE library.
            list(LENGTH MPFR_LIBRARIES num_mpfr_lib)
            math(EXPR last_mpfr_lib ${num_mpfr_lib}-1)
            add_library(MPFR_libmpfr INTERFACE IMPORTED)
            foreach(id_mpfr_lib RANGE ${last_mpfr_lib})
               add_library(MPFR::libmpfr_${id_mpfr_lib} UNKNOWN IMPORTED)
               list(GET MPFR_LIBRARIES ${id_mpfr_lib} the_mpfr_lib)
               set_target_properties(MPFR::libmpfr_${id_mpfr_lib} PROPERTIES
                  IMPORTED_LOCATION "${the_mpfr_lib}"
                  INTERFACE_INCLUDE_DIRECTORIES "${MPFR_INCLUDE_DIRS}")
               target_link_libraries(MPFR_libmpfr INTERFACE MPFR::libmpfr_${id_mpfr_lib})
            endforeach()
            add_library(MPFR::MPFR INTERFACE IMPORTED)
            target_link_libraries(MPFR::MPFR INTERFACE MPFR_libmpfr)
         else()
            message(FATAL_ERROR "Found MPFR version \"${MPFR_VERSION}\" has no MPFR::MPFR target; unable to recover!")
         endif()
      endif()
   endif()
   
   # If SoPlex was built with Boost then we also need it.
   @SOPLEX_CONFIG_BOOST_DIR@
   if(SOPLEX_HAS_BOOST)
      # Extract Boost version in old CMake versions.
      if(Boost_FOUND)
         if(NOT DEFINED Boost_VERSION_STRING)
            math(EXPR _boost_major "${Boost_VERSION} / 100000")
            math(EXPR _boost_minor "${Boost_VERSION} / 100 % 1000")
            math(EXPR _boost_patch "${Boost_VERSION} % 100")
            set(Boost_VERSION_STRING "${_boost_major}.${_boost_minor}.${_boost_patch}")
         endif()
      endif()
      if(NOT Boost_FOUND OR Boost_VERSION_STRING VERSION_LESS @BOOST_MIN_VERSION@)
         find_dependency(Boost @BOOST_MIN_VERSION@)
      endif()
   endif()
   
   # Unindent messages again; equivalent to list(POP_BACK, CMAKE_MESSAGE_INDENT) which requires CMake 3.15.
   list(REVERSE CMAKE_MESSAGE_INDENT)
   list(REMOVE_AT CMAKE_MESSAGE_INDENT 0)
   list(REVERSE CMAKE_MESSAGE_INDENT)
   
   # Include the targets.
   include("${CMAKE_CURRENT_LIST_DIR}/soplex-targets.cmake")
   
   # Add main alias.
   add_library(SOPLEX::SOPLEX ALIAS SOPLEX::libsoplex)

   # Set version.
   set(SOPLEX_VERSION "@SOPLEX_VERSION_MAJOR@.@SOPLEX_VERSION_MINOR@.@SOPLEX_VERSION_PATCH@")

   # Report success.
   if(NOT SOPLEX_FIND_QUIETLY)
      message(STATUS "Found SoPlex version ${SOPLEX_VERSION}.")
   endif()
endif()

# Deprecated variables.
get_target_property(SOPLEX_INCLUDE_DIRS SOPLEX::libsoplex INTERFACE_INCLUDE_DIRECTORIES)
set(SOPLEX_LIBRARIES "SOPLEX_LIBRARIES")
set(SOPLEX_PIC_LIBRARIES "SOPLEX_LIBRARIES")

# Deprecated `SOPLEX_LIBRARIES` target aliases SOPLEX::SOPLEX.
if(NOT TARGET SOPLEX_LIBRARIES)
   add_library(SOPLEX_LIBRARIES INTERFACE IMPORTED)
   if(CMAKE_VERSION VERSION_GREATER_EQUAL 3.17)
      set_target_properties(SOPLEX_LIBRARIES PROPERTIES
         DEPRECATION "Do not use SOPLEX_LIBRARIES anymore, but the SOPLEX::SOPLEX target instead.")
   else()
      message(DEBUG "CMake version ${CMAKE_VERSION} is too low to mark SOPLEX_LIBRARIES target as deprecated!")
   endif()
   target_link_libraries(SOPLEX_LIBRARIES INTERFACE SOPLEX::SOPLEX)
endif()

